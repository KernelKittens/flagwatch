# Storage and source window
FLAGWATCH_DATABASE_PATH=data/flagwatch.db
FLAGWATCH_CTFTIME_ENABLED=false
FLAGWATCH_CTFTIME_LOOKBACK_DAYS=31
FLAGWATCH_CTFTIME_LOOKAHEAD_DAYS=90
FLAGWATCH_SOURCES_PATH=sources.json

# Optional model connector. Providers: openai, azure_openai, anthropic,
# deepseek, litellm, or local. The LiteLLM sidecar exposes an OpenAI-compatible API.
FLAGWATCH_AI_ENABLED=false
FLAGWATCH_AI_PROVIDER=openai
FLAGWATCH_AI_ENDPOINT=https://api.openai.com/v1
FLAGWATCH_AI_MODEL=gpt-5-mini
FLAGWATCH_AI_TIMEOUT_SECONDS=60
FLAGWATCH_AI_API_KEY=

# Docker runtime
FLAGWATCH_PORT=8080
FLAGWATCH_SYNC_INTERVAL_SECONDS=21600

# Optional LiteLLM sidecar. Start it with: docker compose --profile litellm up -d
LITELLM_MASTER_KEY=
FLAGWATCH_LITELLM_UPSTREAM_MODEL=
FLAGWATCH_LITELLM_UPSTREAM_URL=
FLAGWATCH_LITELLM_UPSTREAM_KEY=

# Outbound delivery stays off until this is explicitly enabled
FLAGWATCH_SEND_ENABLED=false

# Discord delivery
FLAGWATCH_DISCORD_WEBHOOK_URL=

# SMTP delivery
FLAGWATCH_SMTP_HOST=
FLAGWATCH_SMTP_PORT=587
FLAGWATCH_SMTP_USERNAME=
FLAGWATCH_SMTP_PASSWORD=
FLAGWATCH_SMTP_FROM=
FLAGWATCH_SMTP_TO=
